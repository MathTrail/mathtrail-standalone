// Devcontainer for MathTrail standalone: all development happens here (see CLAUDE.md).
// Tool versions are pinned directly in this file and in .devcontainer/Dockerfile.
{
    "name": "MathTrail Standalone DevContainer",
    "build": {
        "dockerfile": "Dockerfile",
        // The full environment, not the toolchain stage on its own.
        "target": "devcontainer",
        // Repository root as context; .dockerignore trims it.
        "context": ".."
    },
    "features": {
        // Exact feature version, resolved by digest in devcontainer-lock.json.
        // The feature's own buildx download is unpinned, so it is disabled; compose is installed by
        // the Dockerfile, so the feature's standalone docker-compose is disabled too.
        "ghcr.io/devcontainers/features/docker-in-docker:4.1.1": {
            "version": "29.8.1",
            "moby": true,
            "mobyBuildxVersion": "0.37.1",
            "installDockerBuildx": false,
            "dockerDashComposeVersion": "none"
        }
    },
    "remoteUser": "vscode",
    // Runs on the host before the container starts: gives it a network whose MTU is the
    // host's own, so a tunnel on the host does not silently truncate large downloads here.
    "initializeCommand": "bash .devcontainer/host-network.sh",
    "runArgs": [
        "--network=mathtrail-standalone"
    ],
    "mounts": [
        // Claude Code login and settings survive container rebuilds.
        "source=mathtrail-standalone-claude,target=/home/vscode/.claude,type=volume",
        // The Google sign-in survives them too: the credentials Terraform reads live here.
        "source=mathtrail-standalone-gcloud,target=/home/vscode/.config/gcloud,type=volume",
        // And the GitHub one, so that `gh auth login` is answered once rather than once
        // per rebuild.
        "source=mathtrail-standalone-gh,target=/home/vscode/.config/gh,type=volume"
    ],
    "containerEnv": {
        // Marker checked by Claude sessions (CLAUDE.md, "Devcontainer only").
        "MATHTRAIL_DEVCONTAINER": "1",
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        "DISABLE_AUTOUPDATER": "1"
    },
    "customizations": {
        "vscode": {
            "settings": {
                // gopls and dlv come pinned from the image; the Go extension must not fetch its own.
                "go.toolsManagement.autoUpdate": false,
                "go.toolsManagement.checkForUpdates": "off",
                "files.eol": "\n",
                "files.insertFinalNewline": true,
                // SonarQube for IDE sends nothing about how it is used.
                "sonarlint.disableTelemetry": true
            },
            // Exact versions; the Claude Code extension matches CLAUDE_CODE_VERSION.
            "extensions": [
                "anthropic.claude-code@2.1.280",
                "golang.go@0.56.1",
                // Python is an extension pack: its members are listed too, so that none of them
                // arrives at a floating version.
                "ms-python.python@2026.7.2026092301",
                "ms-python.vscode-pylance@2026.3.105",
                "ms-python.debugpy@2026.7.12571011",
                "ms-python.vscode-python-envs@1.37.2026092301",
                "redhat.vscode-yaml@1.24.0",
                "nefrob.vscode-just-syntax@0.10.2",
                "hashicorp.terraform@2.40.0",
                "bierner.markdown-mermaid@1.32.1",
                "eamodio.gitlens@19.2.0",
                "ms-azuretools.vscode-containers@2.5.1",
                // Sonar's analysis inside the editor. .sonarlint/connectedMode.json offers to
                // bind it to the SonarCloud project, for the project's rules; the token stays
                // with each developer. Its Linux x86-64 package brings its own Java runtime.
                // There is no such package for arm64 and the image installs no Java: there it
                // asks to download one, and analyses nothing if that is declined.
                "SonarSource.sonarlint-vscode@5.10.0"
            ]
        }
    },
    "postStartCommand": "bash .devcontainer/post-start.sh",
    "forwardPorts": [8080]
}
