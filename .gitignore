# Planning documents: reference material for the author, deleted once no longer needed.
/PRODUCT-V1.md
/docs/prototype/
/docs/reconciliation.md

# Secrets
.env

# Build and test output
bin/
dist/
# The load tool's binary and the learners' bench's, when they are built where they live
tools/load/load
tools/learners/learners
# The tables of every cell of the bench's sweep and its refinement: tens of
# megabytes, which a run gives again to the last digit
tools/learners/results/sweep/cells.csv
tools/learners/results/refine/cells.csv
# The drawings command's binary, when it is built at the root
/drawings
coverage.*
*.out
*.test
*.exe
*.prof

# Go workspace files: the product is one module, and the research module under
# research/ builds on its own, without a workspace
go.work
go.work.sum

# Node modules of the widget build (web/)
node_modules/

# The widget as the web build leaves it, the coverage of its tests, and what
# the measure of its layout found, pictures and all: each is made anew, never
# committed. The placeholder beside the widget is committed.
/internal/widget/widget.html
/web/coverage/
/web/layout/

# Rendered site: rebuilt by just site, never committed.
/site/dist/

# Terraform: downloaded providers, state, plans, and the values of one
# deployment. The provider lock file is committed and is not any of these.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
backend.hcl
crash.log
crash.*.log

# Working directory of the static analysis scanner.
.scannerwork/

# The one deployment this repository delivers to is described in the repository,
# not in somebody's console: these two are committed on purpose.
!infra/terraform/prod.auto.tfvars
!infra/terraform/backend.hcl
