# Reference copies of other repositories: read-only material, never committed.
/reference/

# Local copy of the prototype repository: reference material only, never committed.
/prototype/

# Planning documents: reference material for the author, deleted once no longer needed.
/PRODUCT-V1.md
/docs/prototype/
/docs/reconciliation.md
/research/

# Secrets
.env

# Build and test output
bin/
dist/
coverage.*
*.out
*.test
*.exe
*.prof

# Go workspace files: the product is one module, and the research module under
# research/ builds on its own, without a workspace
go.work
go.work.sum

# The research program: its plan, evidence, experiments and paper drafts are
# kept on this machine and out of the repository.
/research/

# Node modules of the widget build (web/)
node_modules/

# Rendered site: rebuilt by just site, never committed.
/site/dist/

# Terraform: downloaded providers, state, plans, and the values of one
# deployment. The provider lock file is committed and is not any of these.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
backend.hcl
crash.log
crash.*.log

# Working directory of the static analysis scanner.
.scannerwork/

# The one deployment this repository delivers to is described in the repository,
# not in somebody's console: these two are committed on purpose.
!infra/terraform/prod.auto.tfvars
!infra/terraform/backend.hcl
