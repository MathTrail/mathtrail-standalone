# Files used inside Linux containers keep LF line endings on every host
*.sh text eol=lf
*.env text eol=lf
justfile text eol=lf
Dockerfile text eol=lf

# Starlark programs are read byte for byte, their comment lines included,
# and hashed into the version of the instructions: LF on every host
*.star text eol=lf
# The examples of the kinds of picture and the ideas of the topics are hashed
# into the same version byte for byte
content/pictures/*.json text eol=lf
content/ideas/*.json text eol=lf

# Default: let Git normalise line endings
* text=auto

# The coach's prototype on the site is the export of the tool it was drawn in,
# with two small pieces taken out of it, and it ships byte for byte as it is
# kept: Git keeps its bytes as they are, shows no diff of the two lines that
# hold nearly all of it, and counts it as generated rather than as written here.
# It comes after the default, which it would otherwise lose to.
site/assets/coach-prototype.html -text -diff linguist-generated

# The paper the page "Research" links is its PDF as the paper's build made it,
# which Git keeps byte for byte, its size and hash vouched for on the page.
site/research/*.pdf binary
