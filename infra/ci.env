# The two facts a workflow needs before it can sign in to Google, and therefore
# before there is any state to read them from. Both are printed by the bootstrap
# script that creates them.
#
# Neither is a secret. The provider is only usable by a token that satisfies its
# condition — one repository, one owner — and the identity behind it holds no key.

GCP_WORKLOAD_IDENTITY_PROVIDER=projects/312162576330/locations/global/workloadIdentityPools/mathtrail-github/providers/github
GCP_TERRAFORM_SERVICE_ACCOUNT=mathtrail-tf@mathtrail-prod.iam.gserviceaccount.com
