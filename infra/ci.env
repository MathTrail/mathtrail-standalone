# The facts a workflow needs before it can sign in to Google, and therefore
# before there is any state to read them from. The first two are printed by the
# bootstrap script that creates them. The third is the identity that reads the
# snapshot of the live numbers, where the deployment keeps counts: what
# `terraform output live_service_account` prints.
#
# None is a secret. The provider is only usable by a token that satisfies its
# condition — one repository, one owner — and the identities behind it hold no
# key.

GCP_WORKLOAD_IDENTITY_PROVIDER=projects/312162576330/locations/global/workloadIdentityPools/mathtrail-github/providers/github
GCP_TERRAFORM_SERVICE_ACCOUNT=mathtrail-tf@mathtrail-prod.iam.gserviceaccount.com
GCP_LIVE_SERVICE_ACCOUNT=mathtrail-live@mathtrail-prod.iam.gserviceaccount.com
