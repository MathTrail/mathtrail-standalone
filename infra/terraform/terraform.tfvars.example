# Copy to terraform.tfvars and fill in. The real file is never committed: it
# carries no secret, but it names one particular deployment.

project_id      = "mathtrail-123456"
billing_account = "01ABCD-234567-89EFGH"

# The host this deployment answers on. Its ownership has to be verified before a
# domain mapping can be created for it.
public_host = "mcp.example.com"

# From the Google OAuth client of this project. The client secret is not here:
# it is added to Secret Manager by hand.
google_oauth_client_id = "123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com"

# Whose workflows may deploy, and the numeric id of the account that owns them.
github_repository = "owner/repository"
github_owner_id   = "12345678"

# Once the domain is mapped and answering, the platform's own address for the
# service is withdrawn and one entrance is left.
# disable_default_url = true

# A deployment with no domain of its own is reached at the platform's address
# instead, and public_host is that address.
# create_domain_mapping = false

# Ceilings the binary would otherwise default to.
# settings = {
#   MATHTRAIL_DAILY_TASKS = "20"
# }
