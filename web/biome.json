{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"root": ".."
	},
	"files": {
		"includes": ["**", "!coverage"]
	},
	"linter": {
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["tools/sitecheck/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/src/**", "**/scripts/**"],
										"message": "The site's checker judges a built directory and knows nothing of what drew it: a check that calls the builder's code tests that a function equals itself."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
