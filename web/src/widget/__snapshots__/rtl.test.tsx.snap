exports[`the screens in Arabic > the wait for a task asked for 1`] = `
<div
  class="mt mt-widget mt-rtl"
>
  <article
    aria-label="المسألة التالية"
  >
    <header
      class="mt-head mt-head-versioned"
    >
      <svg
        aria-hidden="true"
        class="mt-icon mt-mark-light"
        height="32"
        viewBox="0 0 48 48"
        width="32"
      />
      <svg
        aria-hidden="true"
        class="mt-icon mt-mark-dark"
        height="32"
        viewBox="0 0 48 48"
        width="32"
      />
      <div
        class="mt-head-text"
      >
        <div
          class="mt-head-line"
        >
          <span
            class="mt-name"
          >
            MathTrail
          </span>
        </div>
      </div>
      <span
        aria-hidden="true"
        class="mt-version"
      >
        <span
          class="mt-version-label"
        >
          الإصدار
        </span>
         
        <span
          class="mt-version-number"
          dir="ltr"
        >
          0.2.1
        </span>
      </span>
    </header>
    <div
      class="mt-body"
    >
      <div
        class="mt-wait"
      >
        <div
          class="mt-gen"
        >
          <p
            class="mt-gen-title"
          >
            جار إعداد المسألة التالية…
          </p>
          <ol
            aria-live="polite"
          >
            <li
              data-status="active"
            >
              <span
                class="mt-gen-icon"
              >
                <span
                  class="mt-gen-turning"
                >
                  <svg
                    aria-hidden="true"
                    class="mt-icon mt-spin"
                    fill="none"
                    height="20"
                    viewBox="0 0 24 24"
                    width="20"
                  />
                </span>
              </span>
              <span
                class="mt-gen-label"
              >
                <span
                  class="mt-vh"
                >
                  قيد التنفيذ:
                   
                </span>
                تم اختيار الموضوع ومستوى الصعوبة
              </span>
            </li>
            <li
              data-status="waiting"
            >
              <span
                class="mt-gen-icon"
              >
                <svg
                  aria-hidden="true"
                  class="mt-icon"
                  fill="none"
                  height="20"
                  viewBox="0 0 24 24"
                  width="20"
                />
              </span>
              <span
                class="mt-gen-label"
              >
                <span
                  class="mt-vh"
                >
                  في الانتظار:
                   
                </span>
                كتابة المسألة
              </span>
            </li>
            <li
              data-status="waiting"
            >
              <span
                class="mt-gen-icon"
              >
                <svg
                  aria-hidden="true"
                  class="mt-icon"
                  fill="none"
                  height="20"
                  viewBox="0 0 24 24"
                  width="20"
                />
              </span>
              <span
                class="mt-gen-label"
              >
                <span
                  class="mt-vh"
                >
                  في الانتظار:
                   
                </span>
                التحقق من كل إجابة
              </span>
            </li>
            <li
              data-status="waiting"
            >
              <span
                class="mt-gen-icon"
              >
                <svg
                  aria-hidden="true"
                  class="mt-icon"
                  fill="none"
                  height="20"
                  viewBox="0 0 24 24"
                  width="20"
                />
              </span>
              <span
                class="mt-gen-label"
              >
                <span
                  class="mt-vh"
                >
                  في الانتظار:
                   
                </span>
                المسألة جاهزة
              </span>
            </li>
          </ol>
        </div>
        <div
          aria-live="polite"
          class="mt-news"
        />
      </div>
    </div>
  </article>
</div>
`;

