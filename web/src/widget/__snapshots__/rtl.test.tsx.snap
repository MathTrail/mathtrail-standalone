// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the screens in Arabic > the first sign-in 1`] = `
<div
  class="mt mt-widget mt-rtl"
>
  <article
    aria-label="مرحبا بك في MathTrail"
  >
    <header
      class="mt-head"
    >
      <svg
        aria-hidden="true"
        class="mt-icon"
        height="32"
        viewBox="0 0 32 32"
        width="32"
      />
      <div
        class="mt-head-text"
      >
        <div
          class="mt-head-line"
        >
          <span
            class="mt-name"
          >
            MathTrail
          </span>
        </div>
      </div>
    </header>
    <div
      class="mt-body"
    >
      <p
        class="mt-lead"
      >
        يقدم MathTrail للأطفال في الصفوف من 1 إلى 6 مسائل رياضيات بأسلوب الأولمبياد، هنا في الدردشة مباشرة، ويشرح كل خطأ. يتولى إعداده شخص بالغ: أحد الوالدين أو معلم.
      </p>
      <div
        class="mt-note mt-note-plain"
      >
        <div
          class="mt-note-label"
        >
          <span>
            اسم مستعار
          </span>
        </div>
        <p>
          لا يستخدم للطفل إلا اسم مستعار: لا اسم حقيقي أبدا، ولا تاريخ ميلاد، ولا مدرسة.
        </p>
      </div>
      <div
        class="mt-note mt-note-plain"
      >
        <div
          class="mt-note-label"
        >
          <span>
            ما ستسأل عنه الدردشة
          </span>
        </div>
        <p>
          اسم مستعار والصف، من 1 إلى 6. وإن رغبت، أيضا اهتمامات الطفل، وما لم تتناوله المدرسة بعد، ولغة البطاقات.
        </p>
      </div>
      <div
        class="mt-note mt-note-plain"
      >
        <div
          class="mt-note-label"
        >
          <span>
            مكان حفظ البيانات
          </span>
        </div>
        <p>
          في ملف واحد على Google Drive الخاص بك، يمكنك فتحه أو تنزيله أو حذفه. لا يحتفظ MathTrail بأي شيء لديه.
        </p>
      </div>
    </div>
  </article>
  <div
    class="mt-foot"
  >
    <label
      class="mt-check"
    >
      <input
        type="checkbox"
      />
      <span>
        أتولى تربية الطفل أو تدريسه
      </span>
    </label>
    <div
      class="mt-btns"
    >
      <button
        class="mt-btn mt-btn-primary"
        disabled=""
        type="button"
      >
        إنشاء ملف شخصي
      </button>
    </div>
    <p
      aria-live="polite"
      class="mt-action-note"
    >
      
    </p>
  </div>
</div>
`;

exports[`the screens in Arabic > the profile, its cards chosen to be in Arabic 1`] = `
<div
  class="mt mt-widget mt-rtl"
>
  <article
    aria-label="الملف الشخصي"
  >
    <header
      class="mt-head"
    >
      <svg
        aria-hidden="true"
        class="mt-icon"
        height="32"
        viewBox="0 0 24 24"
        width="32"
      />
      <div
        class="mt-head-text"
      >
        <div
          class="mt-head-line"
        >
          <span
            class="mt-name"
          >
            Comet
          </span>
        </div>
        <span
          class="mt-badge"
        >
          الصف 3
        </span>
      </div>
    </header>
    <div
      class="mt-progress"
    >
      <section
        class="mt-fields"
      >
        <h3
          class="mt-section-label"
        >
          الملف الشخصي · لولي الأمر
        </h3>
        <dl>
          <div>
            <dt>
              الصف
            </dt>
            <dd>
              3
            </dd>
            <dd
              class="mt-field-note"
            >
              مجرد تسمية: تغييره لا يؤثر في أي تصنيف.
            </dd>
          </div>
          <div>
            <dt>
              الاهتمامات
            </dt>
            <dd>
              space وanimals وfootball
            </dd>
          </div>
          <div>
            <dt>
              ما لم تتناوله المدرسة بعد
            </dt>
            <dd>
              القسمة مع الباقي
            </dd>
          </div>
          <div>
            <dt>
              لغة البطاقات
            </dt>
            <dd>
              العربية
            </dd>
          </div>
        </dl>
        <div
          class="mt-fields-actions"
        >
          <button
            class="mt-btn"
            type="button"
          >
            تعديل الملف الشخصي
          </button>
          <p
            aria-live="polite"
            class="mt-action-note"
          >
            
          </p>
        </div>
      </section>
      <section
        class="mt-fields"
      >
        <h3
          class="mt-section-label"
        >
          بياناتك
        </h3>
        <dl>
          <div>
            <dt>
              التصدير
            </dt>
            <dd>
              الملف الشخصي كله محفوظ في ملف واحد على Google Drive الخاص بك: mathtrail-profile.json، في المجلد MathTrail. يمكنك تنزيله أو نسخه من هناك، ويمكن أن تعطيك الدردشة رابطه.
            </dd>
            <dd
              class="mt-field-note"
            >
              ملفات أخرى تحتوي على ملف شخصي: mathtrail-profile (1).json. يقرأ MathTrail أحدثها فقط، ويمكنك حذف الباقي.
            </dd>
          </div>
          <div>
            <dt>
              الحذف
            </dt>
            <dd>
              بحذف الملف وإفراغ سلة المهملات في Drive، لا يبقى أي شيء من الملف الشخصي في أي مكان.
            </dd>
          </div>
          <div>
            <dt>
              إلغاء الوصول
            </dt>
            <dd>
              في حساب Google، ضمن التطبيقات التابعة لجهات خارجية التي لها حق الوصول، يمكن إزالة MathTrail، وبعدها لن يصل إلى أي شيء.
            </dd>
          </div>
          <div>
            <dt>
              إزالة التطبيق
            </dt>
            <dd>
              يمكن فصل MathTrail من إعدادات الدردشة نفسها.
            </dd>
          </div>
        </dl>
      </section>
    </div>
  </article>
</div>
`;

