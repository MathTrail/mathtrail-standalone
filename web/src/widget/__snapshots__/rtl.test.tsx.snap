exports[`the screens in Arabic > the profile, its cards chosen to be in Arabic 1`] = `
<div
  class="mt mt-widget mt-rtl"
>
  <article
    aria-label="الملف الشخصي"
  >
    <header
      class="mt-head"
    >
      <svg
        aria-hidden="true"
        class="mt-icon"
        fill="none"
        height="32"
        viewBox="0 0 24 24"
        width="32"
      />
      <div
        class="mt-head-text"
      >
        <div
          class="mt-head-line"
        >
          <span
            class="mt-name"
          >
            Comet
          </span>
        </div>
        <span
          class="mt-badge"
        >
          الصف 3
        </span>
      </div>
    </header>
    <div
      class="mt-progress"
    >
      <section
        class="mt-fields"
      >
        <div
          class="mt-fields-head"
        >
          <h3
            class="mt-section-label"
          >
            الملف الشخصي · لولي الأمر
          </h3>
          <button
            class="mt-btn"
            type="button"
          >
            تعديل
          </button>
        </div>
        <p
          aria-live="polite"
          class="mt-action-note"
        >
          
        </p>
        <dl>
          <div>
            <dt>
              الصف
            </dt>
            <dd>
              3
              <p
                class="mt-field-note"
              >
                مجرد تسمية: تغييره لا يؤثر في أي تصنيف.
              </p>
            </dd>
          </div>
          <div>
            <dt>
              الاهتمامات
            </dt>
            <dd>
              <ul
                class="mt-chips"
              >
                <li
                  class="mt-chip"
                >
                  space
                </li>
                <li
                  class="mt-chip"
                >
                  animals
                </li>
                <li
                  class="mt-chip"
                >
                  football
                </li>
              </ul>
            </dd>
          </div>
          <div>
            <dt>
              ما لم تتناوله المدرسة بعد
            </dt>
            <dd>
              <ul
                class="mt-chips"
              >
                <li
                  class="mt-chip"
                >
                  القسمة مع الباقي
                </li>
              </ul>
            </dd>
          </div>
          <div>
            <dt>
              لغة الدروس
            </dt>
            <dd>
              العربية
            </dd>
          </div>
          <div>
            <dt>
              البلد
            </dt>
            <dd>
              غير محدد
              <p
                class="mt-field-note"
              >
                اختياري. يُستخدم فقط لعدّ الأسر في كل بلد دون أسماء.
              </p>
            </dd>
          </div>
        </dl>
      </section>
      <section
        class="mt-fields"
      >
        <div
          class="mt-fields-head"
        >
          <h3
            class="mt-section-label"
          >
            بياناتك
          </h3>
        </div>
        <dl>
          <div>
            <dt>
              مكان الملف الشخصي
            </dt>
            <dd>
              الملف الشخصي كله محفوظ في ملف واحد على Google Drive الخاص بك: mathtrail-profile.json، في المجلد MathTrail. يمكنك تنزيله أو نسخه من هناك، ويمكن أن تعطيك الدردشة رابطه.
              <p
                class="mt-field-note"
              >
                ملفات أخرى تحتوي على ملف شخصي: mathtrail-profile (1).json. يقرأ MathTrail أحدثها فقط، ويمكنك حذف الباقي.
              </p>
            </dd>
          </div>
          <div>
            <dt>
              طريقة الحذف
            </dt>
            <dd>
              بحذف الملف وإفراغ سلة المهملات في Drive، لا يبقى أي شيء من الملف الشخصي في أي مكان.
            </dd>
          </div>
          <div>
            <dt>
              طريقة إلغاء الوصول
            </dt>
            <dd>
              في حساب Google، ضمن التطبيقات التابعة لجهات خارجية التي لها حق الوصول، يمكن إزالة MathTrail، وبعدها لن يصل إلى أي شيء.
            </dd>
          </div>
          <div>
            <dt>
              طريقة إزالة التطبيق
            </dt>
            <dd>
              يمكن فصل MathTrail من إعدادات الدردشة نفسها.
            </dd>
          </div>
        </dl>
      </section>
    </div>
  </article>
</div>
`;

