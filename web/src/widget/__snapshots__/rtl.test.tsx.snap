exports[`the screens in Arabic > the result of a wrong answer 1`] = `
<div
  class="mt mt-widget mt-rtl"
>
  <div>
    <button
      class="mt-bar"
      type="button"
    >
      <svg
        aria-hidden="true"
        class="mt-icon"
        height="24"
        viewBox="0 0 24 24"
        width="24"
      />
      <span
        class="mt-bar-name"
      >
        مذنّب
      </span>
       
      <span
        class="mt-bar-action"
      >
        الملف الشخصي والتقدم
      </span>
      <svg
        aria-hidden="true"
        class="mt-icon mt-chevron"
        fill="none"
        height="16"
        viewBox="0 0 16 16"
        width="16"
      />
    </button>
    <article
      aria-label="مسألة"
    >
      <header
        class="mt-head"
      >
        <svg
          aria-hidden="true"
          class="mt-icon"
          height="32"
          viewBox="0 0 32 32"
          width="32"
        />
        <div
          class="mt-head-text"
        >
          <div
            class="mt-head-line"
          >
            <span
              class="mt-name"
            >
              MathTrail
            </span>
          </div>
          <span
            class="mt-badge"
          >
            مدرب الأولمبياد · الصف 3
          </span>
        </div>
      </header>
      <div
        class="mt-body"
      >
        <p
          class="mt-task-text"
          dir="rtl"
          lang="ar"
        >
          طول السياج 12 مترًا. تقف الأعمدة كل 3 أمتار، ومنها عمودان عند الطرفين. كم عدد الأعمدة؟
        </p>
        <pre
          aria-label="الرسم"
          class="mt-diagram"
          dir="ltr"
          role="img"
          tabindex="0"
        >
          |--3--|--3--|--3--|--3--|
        </pre>
        <fieldset
          class="mt-options"
        >
          <legend>
            الإجابات
          </legend>
          <div
            class="mt-options-list"
          >
            <button
              aria-disabled="true"
              class="mt-option"
              data-state="muted"
              type="button"
            >
              <span
                class="mt-option-letter"
              >
                A
              </span>
               
              <span
                class="mt-option-value"
                dir="rtl"
                lang="ar"
              >
                3
              </span>
            </button>
            <button
              aria-disabled="true"
              class="mt-option"
              data-state="wrong"
              type="button"
            >
              <span
                class="mt-option-letter"
              >
                B
              </span>
               
              <span
                class="mt-option-value"
                dir="rtl"
                lang="ar"
              >
                4
              </span>
               
              <span
                class="mt-option-status"
              >
                <svg
                  aria-hidden="true"
                  class="mt-icon"
                  fill="none"
                  height="16"
                  viewBox="0 0 16 16"
                  width="16"
                />
                إجابتك
              </span>
            </button>
            <button
              aria-disabled="true"
              class="mt-option"
              data-state="correct"
              type="button"
            >
              <span
                class="mt-option-letter"
              >
                C
              </span>
               
              <span
                class="mt-option-value"
                dir="rtl"
                lang="ar"
              >
                5
              </span>
               
              <span
                class="mt-option-status"
              >
                <svg
                  aria-hidden="true"
                  class="mt-icon"
                  fill="none"
                  height="16"
                  viewBox="0 0 16 16"
                  width="16"
                />
                الإجابة الصحيحة
              </span>
            </button>
            <button
              aria-disabled="true"
              class="mt-option"
              data-state="muted"
              type="button"
            >
              <span
                class="mt-option-letter"
              >
                D
              </span>
               
              <span
                class="mt-option-value"
                dir="rtl"
                lang="ar"
              >
                6
              </span>
            </button>
            <button
              aria-disabled="true"
              class="mt-option"
              data-state="muted"
              type="button"
            >
              <span
                class="mt-option-letter"
              >
                E
              </span>
               
              <span
                class="mt-option-value"
                dir="rtl"
                lang="ar"
              >
                12
              </span>
            </button>
          </div>
        </fieldset>
      </div>
    </article>
    <section
      aria-label="الردود"
      aria-live="polite"
      class="mt-replies"
    >
      <div
        tabindex="-1"
      >
        <article
          class="mt-reply"
        >
          <header
            class="mt-head mt-head-compact"
          >
            <svg
              aria-hidden="true"
              class="mt-icon"
              height="28"
              viewBox="0 0 32 32"
              width="28"
            />
            <div
              class="mt-head-text"
            >
              <span
                class="mt-name"
              >
                MathTrail
              </span>
            </div>
          </header>
          <div
            class="mt-reply-body"
          >
            <p
              class="mt-verdict-line"
            >
              <svg
                aria-hidden="true"
                class="mt-icon"
                fill="none"
                height="20"
                viewBox="0 0 20 20"
                width="20"
              />
              <span>
                ليس تماما: الإجابة هي 5 وليست 4.
              </span>
            </p>
            <div
              class="mt-note mt-note-trap"
            >
              <div
                class="mt-note-label"
              >
                <svg
                  aria-hidden="true"
                  class="mt-icon"
                  fill="none"
                  height="16"
                  viewBox="0 0 16 16"
                  width="16"
                />
                <span>
                  الفخ
                </span>
              </div>
              <p
                dir="rtl"
                lang="ar"
              >
                عُدّت المسافات بدلًا من الأعمدة.
              </p>
            </div>
            <div
              class="mt-steps"
            >
              <h3
                class="mt-section-label"
              >
                الحل
              </h3>
              <ol
                dir="rtl"
                lang="ar"
              >
                <li>
                  <span
                    class="mt-step-num"
                  >
                    1
                  </span>
                   
                  <span>
                    12 ÷ 3 = 4 مسافات.
                  </span>
                </li>
                <li>
                  <span
                    class="mt-step-num"
                  >
                    2
                  </span>
                   
                  <span>
                    في السياج المستقيم الذي تقف أعمدته عند طرفيه يزيد عدد الأعمدة على عدد المسافات بواحد.
                  </span>
                </li>
                <li>
                  <span
                    class="mt-step-num"
                  >
                    3
                  </span>
                   
                  <span>
                    4 + 1 = 5 أعمدة.
                  </span>
                </li>
              </ol>
            </div>
            <div
              class="mt-note mt-note-plain"
            >
              <div
                class="mt-note-label"
              >
                <span>
                  التصنيف في هذا الموضوع
                </span>
              </div>
              <p>
                1502 ← 1480
              </p>
            </div>
          </div>
        </article>
      </div>
    </section>
    <div
      class="mt-foot"
    >
      <div
        class="mt-field"
      >
        <label
          class="mt-vh"
          for="P0-0"
        >
          سؤال عن المسألة
        </label>
        <input
          id="P0-0"
          placeholder="سؤالك عن المسألة…"
          type="text"
        />
        <button
          aria-label="إرسال"
          class="mt-icon-btn"
          disabled=""
          type="button"
        >
          <svg
            aria-hidden="true"
            class="mt-icon mt-send"
            fill="none"
            height="18"
            viewBox="0 0 16 16"
            width="18"
          />
        </button>
      </div>
      <div
        class="mt-btns"
      >
        <button
          class="mt-btn mt-btn-primary"
          type="button"
        >
          مسألة أخرى
        </button>
      </div>
    </div>
  </div>
</div>
`;

