              الصف
            </dt>
            <dd>
              3
              <p
                class="mt-field-note"
              >
                مجرد تسمية: تغييره لا يؤثر في أي تصنيف.
              </p>
            </dd>
          </div>
          <div>
            <dt>
              الاهتمامات
            </dt>
            <dd>
              <ul
                class="mt-chips"
              >
                <li
                  class="mt-chip"
                >
                  space
                </li>
                <li
                  class="mt-chip"
                >
                  animals
                </li>
                <li
                  class="mt-chip"
                >
                  football
                </li>
              </ul>
            </dd>
          </div>
          <div>
            <dt>
              ما لم تتناوله المدرسة بعد
            </dt>
            <dd>
              <ul
                class="mt-chips"
              >
                <li
                  class="mt-chip"
                >
                  القسمة مع الباقي
                </li>
              </ul>
            </dd>
          </div>
          <div>
            <dt>
