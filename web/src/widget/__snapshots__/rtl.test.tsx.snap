              <ol
                dir="rtl"
                lang="ar"
              >
                <li>
                  <span
                    class="mt-step-num"
                  >
                    1
                  </span>
                   
                  <span>
                    12 ÷ 3 = 4 مسافات.
                  </span>
                </li>
                <li>
                  <span
                    class="mt-step-num"
                  >
                    2
                  </span>
                   
                  <span>
                    في السياج المستقيم الذي تقف أعمدته عند طرفيه يزيد عدد الأعمدة على عدد المسافات بواحد.
                  </span>
                </li>
                <li>
                  <span
                    class="mt-step-num"
                  >
                    3
                  </span>
                   
                  <span>
                    4 + 1 = 5 أعمدة.
                  </span>
                </li>
              </ol>
            </div>
            <div
              class="mt-note mt-note-plain"
            >
              <div
                class="mt-note-label"
              >
                <span>
                  التصنيف في هذا الموضوع
                </span>
              </div>
              <p>
                1502 ← 1480
              </p>
            </div>
          </div>
        </article>
      </div>
    </section>
    <div
      class="mt-foot"
    >
      <div
        class="mt-btns"
      >
        <button
          class="mt-btn mt-btn-primary"
          type="button"
        >
          مسألة أخرى
        </button>
      </div>
      <p
        aria-live="polite"
        class="mt-action-note"
      >
        
      </p>
    </div>
  </div>
</div>
`;

