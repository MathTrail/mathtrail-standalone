# Build context filter for images built from the repository root.
# The image needs the Go sources, the widget's, and the site's data the widget
# takes the groups of topics from, and nothing else. A widget built on this
# machine stays out too: the image builds its own.
.git
.github
.vscode
.sonarlint
.env
.devcontainer
docs
infra
testdata
research
tools
site
!site/data.json
bin
dist
coverage.*
*.md
**/node_modules
internal/widget/widget.html
web/coverage
web/layout
web/screens
web/listing
draft
plugin
